    <formulas>
        <name>calculoFechaVencimiento</name>
        <dataType>Date</dataType>
        <expression>{!$Record.ETD__c} 
+ IF ( ISPICKVAL ( {!$Record.Proveedor__r.PlazoPago__c} , &quot;&quot; ) || ISPICKVAL ( {!$Record.Proveedor__r.PlazoPago__c} , &quot;0&quot; ) ,
0 ,
VALUE ( TEXT ( {!$Record.Proveedor__r.PlazoPago__c} ) )
)</expression>
    </formulas>
