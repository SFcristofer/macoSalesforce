    <recordLookups>
        <description>Obtiene la factura(s) de proveedor relacionada al pedido y al proveedor del pedido que: (i) Sea de tipo &apos;Balance&apos; o &apos;Total&apos;; (ii) Tenga un estado &apos;Recibida&apos;, o &apos;Contabilizada&apos;.</description>
        <name>ObtenerFacturasProveedor</name>
        <label>Obtener facturas proveedor</label>
        <locationX>532</locationX>
        <locationY>276</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>ExistenFacturasProveedor</targetReference>
        </connector>
        <filterLogic>1 AND ( 2 OR 3 ) AND ( 4 OR 5 )</filterLogic>
        <filters>
            <field>Pedido__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Tipo__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Balance</stringValue>
            </value>
        </filters>
        <filters>
            <field>Tipo__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Total</stringValue>
            </value>
        </filters>
        <filters>
            <field>Estado__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Creada</stringValue>
            </value>
        </filters>
        <filters>
            <field>Estado__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Contabilizada</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>FacturaDeProveedor__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Obtiene el Id la función &apos;Gerencia Compras&apos;.</description>
