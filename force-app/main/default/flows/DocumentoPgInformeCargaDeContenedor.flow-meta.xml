<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>ExistePedidoDeCompraAsociado</name>
        <label>Existe pedido de compra asociado</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>ExistePedidoDeCompraAsociado_Si</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.PedidoDeCompra__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ActualizarPedidoDeCompra</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <description>Actualiza el pedido de compra relacionado con el documento PG, cuando el tipo de documento es &quot;Informe de Cargo de Contenedor&quot;.</description>
    <environments>Default</environments>
    <interviewLabel>Documento PG: {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Documento PG: Informe carga de contenedor</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>En el Pedido de Compra relacionado con el Documento PG, marca como verdadero &quot;Fotos cargue contenedor&quot;.</description>
        <name>ActualizarPedidoDeCompra</name>
        <label>Actualizar Pedido de Compra</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.PedidoDeCompra__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>fotos_cargue_cont__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>PedidoDeCompra__c</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ExistePedidoDeCompraAsociado</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Tipo_de_Documento__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Informe Carga de Contenedor</stringValue>
            </value>
        </filters>
        <object>Documento__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>800</triggerOrder>
</Flow>
