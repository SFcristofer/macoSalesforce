    <formulas>
        <name>calculoFechaVencimiento</name>
        <dataType>Date</dataType>
        <expression>TODAY()
+ IF ( ISPICKVAL ( {!recordId.Proforma__r.Cuenta__r.Parent.PlazoPago__c} , &quot;&quot; ) ,
0 ,
VALUE ( TEXT ( {!recordId.Proforma__r.Cuenta__r.Parent.PlazoPago__c} ) )
)</expression>
    </formulas>
    <formulas>
        <name>calculoTotalItem</name>
        <dataType>Currency</dataType>
        <expression>{!BuclePedidoLineItemsSeleccionados.Unidades__c} * {!BuclePedidoLineItemsSeleccionados.PrecioDeVenta__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaMarcaDeProducto</name>
        <dataType>String</dataType>
        <expression>IF ( CONTAINS ( {!BuclePedidoLineItemsSeleccionados.Producto__r.Marca2__c} , &quot;(&quot; ) ,
TRIM (
MID (
{!BuclePedidoLineItemsSeleccionados.Producto__r.Marca2__c} ,
3 ,
FIND ( &quot;(&quot; , {!BuclePedidoLineItemsSeleccionados.Producto__r.Marca2__c} ) - 3
)
) ,
TRIM (
MID (
{!BuclePedidoLineItemsSeleccionados.Producto__r.Marca2__c} ,
3 ,
LEN ( {!BuclePedidoLineItemsSeleccionados.Producto__r.Marca2__c} ) - 2
)
)
)</expression>
    </formulas>
