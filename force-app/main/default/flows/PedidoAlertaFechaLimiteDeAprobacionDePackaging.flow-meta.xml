                <elementReference>asuntoEmailFechaLimiteAprobacionPackagingVentas</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>cuerpoEmailFechaLimiteAprobacionPackaging</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Proforma__r.Oportunidad__r.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <actionCalls>
        <description>Envía una alerta de email al propietario del pedido.</description>
        <name>EmailPropietarioDePedido</name>
        <label>Email propietario de pedido</label>
        <locationX>308</locationX>
        <locationY>288</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>EmailPropietarioDeOportunidad</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>asuntoEmailFechaLimiteAprobacionPackagingCompras</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>cuerpoEmailFechaLimiteAprobacionPackaging</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Owner:User.Email</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Programa el envío de una alerta de email 5 días antes de la fecha límite de aprobación de packaging si no hay fecha de aprobación de packaging del cliente.</description>
    <environments>Default</environments>
    <interviewLabel>Pedido: Alerta fecha límite de aprobación de packaging {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pedido: Alerta fecha límite de aprobación de packaging</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Fecha_limite_de_aprobacion_de_Packaging__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Fecha_aprobacion_Packaging_Cliente__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>PedidoDeCompra__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X5DiasAntesDeFlap</name>
            <connector>
                <targetReference>EmailPropietarioDePedido</targetReference>
            </connector>
            <label>5 días antes de FLAP</label>
            <offsetNumber>-5</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Fecha_limite_de_aprobacion_de_Packaging__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>Asunto del email de alerta para la fecha límite de aprobación de packaging para compras.</description>
        <name>asuntoEmailFechaLimiteAprobacionPackagingCompras</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Alerta de fecha límite de aprobación de packaging para el pedido {!$Record.Name}</text>
    </textTemplates>
    <textTemplates>
        <description>Asunto del email de alerta para la fecha límite de aprobación de packaging para ventas.</description>
        <name>asuntoEmailFechaLimiteAprobacionPackagingVentas</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Alerta de fecha límite de aprobación de packaging para el pedido {!$Record.Name} relacionado con la proforma {!$Record.Proforma__r.Name} y la oportunidad {!$Record.Proforma__r.Oportunidad__r.Name} del cliente {!$Record.Proforma__r.Cuenta__r.Name}</text>
    </textTemplates>
    <textTemplates>
        <description>Cuerpo del email de alerta para la fecha límite de aprobación de packaging.</description>
        <name>cuerpoEmailFechaLimiteAprobacionPackaging</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Faltan 5 días para la fecha límite de aprobación de packaging para el pedido {!$Record.Name}.</text>
    </textTemplates>
    <triggerOrder>400</triggerOrder>
</Flow>
