    <formulas>
        <name>cambioCargoReadyDate</name>
        <dataType>String</dataType>
        <expression>IF ( {!$Record.ETD__c} &lt;&gt; {!$Record__Prior.ETD__c} ,
TEXT ( {!$Record.ETD__c} ) &amp; &quot; (antes &quot; &amp; TEXT ( {!$Record__Prior.ETD__c} ) &amp; &quot;)&quot; ,
TEXT ( {!$Record.ETD__c} ) &amp; &quot; (sin cambios)&quot;
)</expression>
    </formulas>
    <formulas>
        <name>cambioFinalShippingWindow</name>
        <dataType>String</dataType>
        <expression>IF ( {!$Record.Final_Shipping_Window__c} &lt;&gt; {!$Record__Prior.Final_Shipping_Window__c} ,
TEXT ( {!$Record.Final_Shipping_Window__c} ) &amp; &quot; (antes &quot; &amp; TEXT ( {!$Record__Prior.Final_Shipping_Window__c} ) &amp; &quot;)&quot; ,
TEXT ( {!$Record.Final_Shipping_Window__c} ) &amp; &quot; (sin cambios)&quot;
)</expression>
    </formulas>
    <formulas>
