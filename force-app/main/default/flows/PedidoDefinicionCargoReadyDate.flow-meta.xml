    <decisions>
        <name>ProveedorRequiereBalance</name>
        <label>Proveedor requiere balance</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>AsignarValoresVariablesCreacionFacturaProveedor</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Sí</defaultConnectorLabel>
        <rules>
            <name>ProveedorRequiereBalance_No</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Proveedor__r.PorcentajeDeposito__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>100</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>pedidoEsSimulacion</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>No</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>calculoFechaVencimiento</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Fecha_de_Compromiso_con_el_Cliente__c}
+ (
IF ( ISPICKVAL ( {!$Record.Proveedor__r.PlazoPago__c} , &quot;&quot; ) || ISPICKVAL ( {!$Record.Proveedor__r.PlazoPago__c} , &quot;0&quot; ) ,
0 ,
VALUE ( TEXT ( {!$Record.Proveedor__r.PlazoPago__c} ) )
)
+ 10
)</expression>
    </formulas>
    <formulas>
        <name>calculoPlazoDePago</name>
        <dataType>Number</dataType>
        <expression>IF ( 
( ISPICKVAL ( {!$Record.Proveedor__r.PlazoPago__c} , &quot;&quot; ) || ISPICKVAL ( {!$Record.Proveedor__r.PlazoPago__c} , &quot;0&quot; ) ) ,
5 ,
VALUE ( TEXT ( {!$Record.Proveedor__r.PlazoPago__c} ) )
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>calculoPorcentajeFactura</name>
        <dataType>Number</dataType>
        <expression>100 - VALUE ( TEXT ( {!$Record.Proveedor__r.PorcentajeDeposito__c} ) )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>pedidoEsSimulacion</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.RecordType.DeveloperName} = &quot;Simulacion&quot;
|| {!$Record.RecordType.DeveloperName} = &quot;Simulacion_Aprobador&quot;</expression>
    </formulas>
