    <description>Programa el envío de una alerta de email si no se ha solicitado el booking a la naviera, usando como referencia al Initial Shipping Window.</description>
    <environments>Default</environments>
    <formulas>
        <description>Determina el número de días que faltan desde el día en curso hasta el Initial Shipping Window.</description>
        <name>diasParaInitialShippingWindow</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Fecha_Minima_Embarque__c} - TODAY()</expression>
        <scale>0</scale>
