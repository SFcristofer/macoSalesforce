    <formulas>
        <name>calculoAjuste</name>
        <dataType>Currency</dataType>
        <expression>-1 * ( ( 100 - {!porcentajeFactura} ) / 100 ) * {!ObtenerTotalFacturaDeProveedor.Total__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>calculoPlazoDePago</name>
        <dataType>Date</dataType>
        <expression>TODAY() + {!plazoDePago}</expression>
    </formulas>
    <formulas>
        <name>calculoTotalItemSubflujo</name>
        <dataType>Currency</dataType>
        <expression>{!BuclePedidoLineItemsPorFacturar.Unidades__c} * {!BuclePedidoLineItemsPorFacturar.CostoOrigen__c}</expression>
        <scale>2</scale>
    </formulas>
