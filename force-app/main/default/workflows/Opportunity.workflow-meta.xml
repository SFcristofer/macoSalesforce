<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>CambioIncoterms</fullName>
        <description>Si cambian los incoterms de una oportunidad se le envía un email a compras</description>
        <protected>false</protected>
        <recipients>
            <recipient>soporte2.tecnovalue@pacificglob.com</recipient>
            <type>user</type>
        </recipients>
        <recipients>
            <recipient>veronica.bernardo@pacificglob.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/CambioIncoterms</template>
    </alerts>
    <alerts>
        <fullName>Productos_con_nuevo_packaging_resueltos</fullName>
        <description>Productos con nuevo packaging resueltos</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Productos_con_nuevo_packaging_resueltos</template>
    </alerts>
    <rules>
        <fullName>Cambio de Incoterms</fullName>
        <actions>
            <name>CambioIncoterms</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <description>Si cambian los incoterms de una oportunidad se le envía un email a compras</description>
        <formula>ISCHANGED(Incoterm__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Seguimiento de Reposicion</fullName>
        <actions>
            <name>Seguimiento_de_Reposicion</name>
            <type>Task</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity.IsClosed</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.IsWon</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Seguimiento_de_Reposici_n__c</field>
            <operation>equals</operation>
            <value>Si</value>
        </criteriaItems>
        <description>Cuando se cierra una oportunidad se elige cuando se quiere hacer el seguimiento de reposicion</description>
        <failedMigrationToolVersion>240.11.5</failedMigrationToolVersion>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <tasks>
        <fullName>Seguimiento_de_Reposicion</fullName>
        <assignedToType>owner</assignedToType>
        <dueDateOffset>0</dueDateOffset>
        <notifyAssignee>false</notifyAssignee>
        <offsetFromField>Opportunity.Fecha_seguimiento_Reposicion__c</offsetFromField>
        <priority>Normal</priority>
        <protected>false</protected>
        <status>Open</status>
        <subject>Seguimiento de Reposición</subject>
    </tasks>
</Workflow>
